{
  "name": "vinylbox",
  "productName": "VinylBox",
  "version": "0.6.1",
  "description": "YouTube 音乐下载缓存 + 黑胶唱片质感播放器",
  "main": "./out/main/index.js",
  "author": "musicForYou",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "apk": "node scripts/pack-android.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.21.5"
  }
}
