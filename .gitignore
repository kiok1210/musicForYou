node_modules/
out/
dist/
release/
*.log
.DS_Store
.vite/

# ── 打包用的二进制 ─────────────────────────────────────
# ffmpeg 84MB + yt-dlp 17MB，进版本库既撑爆仓库也没意义
# （它们各自有公开发布渠道）。需要时按 README 放进 resources/bin。
resources/bin/*.exe
resources/bin/ffmpeg
resources/bin/yt-dlp
resources/bin/*.dmg

# ── 签名与本地配置 ─────────────────────────────────────
# 密钥泄露等于任何人都能伪装成你的更新包
*.jks
*.keystore
keystore.properties
android/local.properties

# ── 手机端的自动生成产物 ───────────────────────────────
# 这些由 cap sync / cap copy 生成，且已被 android/.gitignore 覆盖；
# 这里再挡一层，防止那个生成文件某天被覆盖后漏过来。
android/capacitor-cordova-android-plugins/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/build/
android/.gradle/
android/build/

# ── 临时文件 ───────────────────────────────────────────
.tmp-*
apk/
